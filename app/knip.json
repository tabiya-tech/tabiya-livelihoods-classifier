{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/mocks/browser.ts",
    "src/mocks/server.ts",
    "src/**/*.stories.tsx",
    "src/**/*.test.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreDependencies": ["@storybook/blocks"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn"
  }
}
