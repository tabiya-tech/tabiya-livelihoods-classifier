# Tabiya Livelihoods Classifier — Environment Variables
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the values below.

# ─── Language ─────────────────────────────────────────────────────────────────
# Every service image serves every registered language (backend/shared/shared/languages/).
# The language is normally an *input*: callers send `language` on /v1/ner, /v1/nel,
# /v1/classify and /v2/nel — that is what the job-pipeline Workflow sets per country.
# These variables only decide what happens when a request does not say.

# Default language for requests that omit one: en | es (a locale like AR-es also works).
# TARGET_LANGUAGE=en

# Languages whose models are loaded at startup. Others still work — they load on the
# first request that asks for them, which makes that request slow. `all` = every
# registered language. Default: just TARGET_LANGUAGE.
# ENABLED_LANGUAGES=en,es

# ─── NER Service ──────────────────────────────────────────────────────────────

# REQUIRED — HuggingFace access token for the NER model.
# Request access to tabiya/roberta-base-job-ner, then create a
# read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# NER model name (HuggingFace repo or local path). Applies to every language.
NER_MODEL=tabiya/roberta-base-job-ner

# Per-language override: NER_MODEL_<LANG> wins over NER_MODEL for that language.
# There is no Spanish job-NER checkpoint yet, so `es` falls back to the English model
# and both the logs and the response metadata (model_is_language_specific=false) say
# so. Point this at a Spanish or multilingual token-classification model to fix it.
# NER_MODEL_ES=

# ─── NEL Service ──────────────────────────────────────────────────────────────

# Sentence embedding model for ESCO linking. Applies to every language.
LINKER_MODEL=all-MiniLM-L6-v2

# Per-language override. `es` defaults to a multilingual model with the same 384 dims.
# LINKER_MODEL_ES=paraphrase-multilingual-MiniLM-L12-v2

# Path to directory containing occupations_augmented.csv, skills.csv,
# qualifications.csv, and their embedding cache folders.
# Defaults to backend/nel/nel/files/<language>/ — one data pack per language, built with
#   python backend/nel/scripts/build_nel_files.py --taxonomy-dir <export> --language es
# Setting this pins ALL languages to one directory; leave it unset for multi-language.
# NEL_FILES_PATH=

# nel_v2 only — taxonomy model id per language, in the taxonomy platform. When a request
# names a language, its model id wins over the caller's user config.
# TAXONOMY_MODEL_ID_EN=
# TAXONOMY_MODEL_ID_ES=

# ─── Classify Service ─────────────────────────────────────────────────────────

# Internal service URLs (used by classify-api to call NER and NEL)
NER_API_URL=http://localhost:5002
NEL_API_URL=http://localhost:5003

# URL for the docs site (shown in the app sidebar)
VITE_DOCS_URL=http://localhost:5174

CLASSIFIER_VERSION=1.0.0

# ─── API Limits ───────────────────────────────────────────────────────────────

MAX_TEXT_LENGTH=50000
MAX_BATCH_SIZE=500
MAX_ENTITIES_PER_REQUEST=200
MAX_TOP_K=50

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Required for API key validation and per-user config resolution.
APPLICATION_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tabiya-classifier

# Cache TTL (seconds) for API key → user config lookups
API_KEY_CACHE_TTL=300

# ─── Environment configuration ───────────────────────────────────────────
TARGET_ENVIRONMENT_TYPE=local